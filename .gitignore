node_modules/
dist/
*.db
*.db-shm
*.db-wal
.env
.env.local
.DS_Store
.vscode/
.idea/
*.log
logs/
# Claude Code project files — track skills, ignore notes
.claude/*
!.claude/skills/
!.claude/commands/

# Session notes are voluminous, machine-local and regenerated — they do not
# belong in the package. Notes/docs/ is different: product overview, pricing,
# roadmap, technical architecture and the task-bus design are documentation, and
# were silently local-only. `git ls-files Notes/` returned ONE file against 17
# on disk, so a correction made to task-bus.md today existed on this machine and
# nowhere else.
#
# Written as Notes/* rather than Notes/, because git cannot re-include anything
# beneath an excluded DIRECTORY — the negation below only works if the directory
# itself is not the thing excluded.
Notes/*
!Notes/docs/
.pai/
# Root-anchored: this hides the working tasks/todo.md convention, NOT src/tasks/
# (the task-bus module). A bare `tasks/` matches any depth and silently drops
# source from commits while the build still succeeds locally.
/tasks/
History/
Journal/
scratchpad/

# Obsidian vault metadata files
PAI.md
_index.md
src/hooks/hooks.md
templates/templates.md

# User skills — local customizations that survive git pull
templates/skills/user/*
!templates/skills/user/.gitkeep

# User-created MCP prompts — local customizations that survive git pull
src/daemon-mcp/prompts/custom/*
!src/daemon-mcp/prompts/custom/.gitkeep

# User extensions — custom hooks and skills that survive git pull
user-extensions/hooks/*
!user-extensions/hooks/.gitkeep
user-extensions/skills/*
!user-extensions/skills/.gitkeep
