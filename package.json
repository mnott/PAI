{
  "name": "@tekmidian/pai",
  "version": "1.1.1",
  "description": "PAI Knowledge OS — Personal AI Infrastructure with federated memory and project management",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.prune-manifest.json",
    "templates",
    "bench",
    "antipatterns",
    "plugins",
    "user-extensions",
    ".claude-plugin",
    "pai-plugin.json",
    "gemini-extension.json",
    "statusline-command.sh",
    "tab-color-command.sh",
    "docker/init.sql",
    "docker/docker-compose.yml",
    "src/hooks",
    "!src/hooks/**/*.test.ts",
    "!src/hooks/ts",
    "docs",
    "!docs/images",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "FEATURE.md",
    "PLUGIN-ARCHITECTURE.md"
  ],
  "keywords": [
    "ai",
    "knowledge-os",
    "personal-ai",
    "mcp",
    "claude",
    "memory",
    "project-management",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnott/PAI.git"
  },
  "homepage": "https://github.com/mnott/PAI",
  "bin": {
    "pai": "dist/cli/index.mjs",
    "pai-daemon": "dist/daemon/index.mjs",
    "pai-daemon-mcp": "dist/daemon-mcp/index.mjs"
  },
  "scripts": {
    "build": "node scripts/sync-versions.mjs && node scripts/gen-builtin-rules.mjs && tsdown && node scripts/prune-dist.mjs && node scripts/copy-defaults.mjs && node scripts/build-hooks.mjs --sync && node scripts/build-skill-stubs.mjs --sync && node scripts/build-docs.mjs",
    "version": "node scripts/sync-versions.mjs && git add .claude-plugin pai-plugin.json gemini-extension.json .cursor plugins",
    "dev": "tsdown --watch",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "prepublishOnly": "bun run build && node dist/cli/index.mjs worker pending --gate && node dist/cli/index.mjs build npm-auth"
  },
  "author": "Matthias Nott",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "js-tiktoken": "^1.0.21",
    "pg": "^8.13.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.11.11",
    "jscpd": "4.3.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
