{
  "description": "Essential lifecycle hooks for session management, context loading, and security",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/load-core-context.mjs" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/load-project-context.mjs" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/initialize-session.mjs" }
        ]
      },
      {
        "matcher": "resume|compact",
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/mcp-deferred-reminder.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/security-validator.mjs" }
        ]
      },
      {
        "matcher": "mcp__",
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/mcp-deferred-gate.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/stop-hook.mjs" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/pai-session-stop.sh" }
        ]
      }
    ]
  }
}
