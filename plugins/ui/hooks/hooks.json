{
  "description": "Terminal tab titles, statusline updates, and visual feedback hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/update-tab-titles.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/update-tab-on-action.mjs" }
        ]
      }
    ]
  }
}
