{
  "description": "Hooks for TODO sync, session cleanup, and productivity workflows",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/sync-todo-to-md.mjs" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/cleanup-session-files.mjs" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "${PAI_DIR}/Hooks/worker-supervision.mjs" }
        ]
      }
    ]
  }
}
